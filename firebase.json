{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "**/*.py",
      "README.md",
      "firestore.rules",
      "database.rules.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" }
}
